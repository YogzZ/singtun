{
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "default_domain_resolver": {
      "server": "dns-local",
      "strategy": "ipv4_only"
    },
    "rules": [
      {
        "action": "sniff"
      },
      {
        "domain": [
          "localhost",
          "ip6-localhost",
          "ip6-loopback"
        ],
        "domain_suffix": [
          ".localhost",
          ".local"
        ],
        "action": "reject"
      },
      {
        "network": "tcp",
        "port": 25,
        "action": "reject"
      },
      {
        "port": [
          135,
          445,
          6969
        ],
        "action": "reject"
      },
      {
        "port_range": [
          "137:139",
          "6881:6889"
        ],
        "action": "reject"
      },
      {
        "protocol": "bittorrent",
        "action": "reject"
      },
      {
        "action": "resolve",
        "strategy": "ipv4_only"
      },
      {
        "ip_is_private": true,
        "action": "reject"
      },
      {
        "ip_cidr": [
          "0.0.0.0/8",
          "10.0.0.0/8",
          "100.64.0.0/10",
          "127.0.0.0/8",
          "169.254.0.0/16",
          "172.16.0.0/12",
          "192.0.0.0/24",
          "192.168.0.0/16",
          "198.18.0.0/15",
          "224.0.0.0/4",
          "240.0.0.0/4",
          "::/128",
          "::1/128",
          "::ffff:0:0/96",
          "64:ff9b::/96",
          "64:ff9b:1::/48",
          "100::/64",
          "fc00::/7",
          "fe80::/10",
          "ff00::/8"
        ],
        "action": "reject"
      }
    ],
    "final": "direct"
  }
}
