{
  "inbounds": [
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "0.0.0.0",
      "listen_port": 8443,
      "users": [],
      "masquerade": {
        "type": "file",
        "directory": "/var/www/singtun-site"
      },
      "tls": {
        "enabled": true,
        "alpn": [
          "h3"
        ],
        "certificate_path": "/etc/singtun/cert/fullchain.pem",
        "key_path": "/etc/singtun/cert/key.pem"
      }
    }
  ]
}
