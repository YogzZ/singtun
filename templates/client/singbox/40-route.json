{
  "http_clients": [
    {
      "tag": "http-proxy",
      "detour": "proxy"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": {
      "server": "dns-direct",
      "strategy": "ipv4_only"
    },
    "default_http_client": "http-proxy",
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/23066e3b0833d1484916637dde2b5bae80178045/geosite-cn.srs",
        "http_client": "http-proxy"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/eb32cd6ed4a16fcb3bf9a36ccebf28e45716ae84/geoip-cn.srs",
        "http_client": "http-proxy"
      }
    ],
    "rules": [
      {
        "action": "sniff"
      },
      {
        "protocol": "dns",
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "ip_cidr": [
          "100.64.0.0/10",
          "169.254.0.0/16"
        ],
        "outbound": "direct"
      },
      {
        "protocol": "bittorrent",
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": 123,
        "outbound": "direct"
      },
      {
        "clash_mode": "direct",
        "outbound": "direct"
      },
      {
        "domain": [
          "mask.icloud.com",
          "mask-h2.icloud.com",
          "mask-api.icloud.com"
        ],
        "action": "reject"
      },
      {
        "clash_mode": "global",
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "clash_mode": "global",
        "outbound": "proxy"
      },
      {
        "domain_suffix": [
          "google",
          "google.com",
          "gstatic.com",
          "googleapis.com",
          "googleusercontent.com",
          "ggpht.com",
          "1e100.net",
          "gvt1.com",
          "gvt2.com",
          "gvt3.com",
          "appspot.com",
          "firebaseio.com",
          "firebaseapp.com",
          "crashlytics.com",
          "app-analytics-services.com",
          "app-measurement.com",
          "googletagmanager.com",
          "googletagservices.com",
          "google-analytics.com",
          "googlesyndication.com",
          "doubleclick.net",
          "2mdn.net",
          "recaptcha.net",
          "pki.goog",
          "ampproject.org",
          "android.com"
        ],
        "network": "udp",
        "port": 443,
        "action": "reject"
      },
      {
        "domain_suffix": [
          "google",
          "google.com",
          "gstatic.com",
          "googleapis.com",
          "googleusercontent.com",
          "ggpht.com",
          "1e100.net",
          "gvt1.com",
          "gvt2.com",
          "gvt3.com",
          "appspot.com",
          "firebaseio.com",
          "firebaseapp.com",
          "crashlytics.com",
          "app-analytics-services.com",
          "app-measurement.com",
          "googletagmanager.com",
          "googletagservices.com",
          "google-analytics.com",
          "googlesyndication.com",
          "doubleclick.net",
          "2mdn.net",
          "recaptcha.net",
          "pki.goog",
          "ampproject.org",
          "android.com"
        ],
        "outbound": "proxy"
      },
      {
        "rule_set": [
          "geosite-cn",
          "geoip-cn"
        ],
        "outbound": "direct"
      },
      {
        "network": "udp",
        "port": 443,
        "action": "reject"
      }
    ],
    "final": "proxy"
  }
}
