# 复制为 private/.env 后填写（或执行 ./ssctl init 自动生成密钥与路径前缀）。
# private/ 已被 git 忽略；本文件权限应为 600。
# 所有示例值均为文档保留地址/域名（RFC 5737 / RFC 2606），请替换为真实值。

# ---- 版本固定与客户端兼容 ----
SINGBOX_VERSION=1.14.4            # 示例值：部署时固定为当时的最新稳定版，升级用 ./ssctl upgrade
SINGBOX_CLIENT_COMPAT=1.14        # 客户端 sing-box 配置语法版本 (1.14 | 1.12)；旧版 App Store 客户端可设为 1.12
# 可选：当 APT 仓库不含目标版本、回退到官方 GitHub Release deb 包且版本号不在 scripts/lib/singbox.sha256 时填写
SINGBOX_DEB_SHA256_AMD64=
SINGBOX_DEB_SHA256_ARM64=

# ---- 服务器 ----
SERVER_IP=203.0.113.10            # 固定公网 IPv4；客户端节点 server 字段直连该 IP
SERVER_DOMAIN=node.example.com    # 连接用子域名，作 SNI / 证书 / 订阅域名（Cloudflare 必须设为 DNS only）
SERVER_IPV6=false                 # 默认 false：服务端与客户端均强制 ipv4_only，并在客户端 TUN 中阻断 IPv6 旁路
SERVER_LOG_LEVEL=warn             # sing-box 日志级别 (trace|debug|info|warn|error|fatal|panic)；默认 warn 不记录访问域名（journald 限额 64MB/7天），追求零连接错误落盘可设 fatal，排障可临时改 info

# ---- 证书（Cloudflare DNS-01）----
ACME_EMAIL=admin@example.com
CF_API_TOKEN=                     # 仅需 Zone.DNS:Edit 权限
ACME_NOTIFY_HOOK=                 # 可选：acme.sh 续期告警钩子（如 telegram / discord / webhook，需同时在本文件配置对应钩子变量）

# ---- 主协议：VLESS + REALITY + Vision（回落本机 Nginx）----
VLESS_PORT=443
REALITY_HANDSHAKE_PORT=8443       # Nginx 仅监听 127.0.0.1
REALITY_PRIVATE_KEY=              # ssctl init 生成（sing-box generate reality-keypair）
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=                 # ssctl init 生成（sing-box generate rand --hex 8）
UTLS_FINGERPRINT=chrome

# ---- 可选：Hysteria2（复用证书，file 模式复用本机回落静态站点目录）----
ENABLE_HY2=false
HY2_PORT=8443                     # UDP，与 REALITY_HANDSHAKE_PORT(TCP, 仅本机) 不冲突
HY2_OBFS=false                    # 可选：开启 salamander 混淆以静默丢弃主动 UDP/QUIC 探测（防跳跃端口测绘时可设 true）
HY2_HOP_PORTS=                    # 可选端口跳跃范围，如 20000-30000；留空关闭
HY2_UP_MBPS=                      # 可选：客户端上行带宽提示，留空使用 BBR
HY2_DOWN_MBPS=

# ---- 订阅管理（按需通过 sudo ./ssctl add [name] 创建）----
# 警告：公网订阅 URL 本身包含完整节点凭据，切勿公开粘贴、截图或转发；疑似泄露请立即执行 sudo ./ssctl reset <name>
ENABLE_SUBSCRIPTION=true          # 复用 443 回落 Nginx 托管高熵路径静态订阅；设为 false 则移除公网订阅仅保留本地 private/out/
SUB_PATH_PREFIX=                  # ssctl init 生成的 16 位随机无特征路径前缀（p + 15 位十六进制，严禁使用 sub 等特征词）
SUBSCRIPTIONS=""                  # 当前生效的订阅名列表（初始为空，由 ssctl add/del 自动维护，每项对应独立 UUID_<NAME> 与 SUB_TOKEN_<NAME>）

# ---- DNS（三端均使用免域名 Bootstrap 的加密 IP-DoH https://<IP>/dns-query）----
DNS_DIRECT=223.5.5.5              # 国内直连 DoH（支持 223.5.5.5 | 223.6.6.6）
DNS_REMOTE=1.1.1.1                # 海外 DoH（支持 1.1.1.1 | 1.0.0.1 | 8.8.8.8 | 8.8.4.4 | 9.9.9.9；sing-box/mihomo 经代理解析，Shadowrocket 为客户端加密请求）

# ---- 规则集（默认固定官方 Commit SHA 防上游分支投毒；如需自动跟随上游或替换镜像可自定义 HTTPS URL）----
RULESET_GEOSITE_CN=https://raw.githubusercontent.com/SagerNet/sing-geosite/23066e3b0833d1484916637dde2b5bae80178045/geosite-cn.srs
RULESET_GEOIP_CN=https://raw.githubusercontent.com/SagerNet/sing-geoip/eb32cd6ed4a16fcb3bf9a36ccebf28e45716ae84/geoip-cn.srs
RULESET_MIHOMO_GEOSITE_CN=https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/458e716abd80ff8c6aee2b7d15c4f94b20e9d279/geo/geosite/cn.mrs
RULESET_MIHOMO_GEOIP_CN=https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/458e716abd80ff8c6aee2b7d15c4f94b20e9d279/geo/geoip/cn.mrs
RULESET_SR_CN_DOMAIN=https://raw.githubusercontent.com/Loyalsoldier/surge-rules/d2ff19cde30a09df3e6a527cb3996ccd506cbfea/direct.txt
