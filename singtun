#!/usr/bin/env bash
# singtun — 个人跨境代理服务端部署与多端订阅管理 CLI
set -euo pipefail

_resolve_self_path() {
  local p="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    local resolved=""
    if resolved="$(readlink -f "${p}" 2>/dev/null)" && [[ -n "${resolved}" ]]; then
      printf '%s\n' "${resolved}"
      return 0
    fi
  fi
  local dir=""
  while [[ -L "${p}" ]]; do
    dir="$(cd -P "$(dirname "${p}")" && pwd)"
    p="$(readlink "${p}")"
    [[ "${p}" == /* ]] || p="${dir}/${p}"
  done
  dir="$(cd -P "$(dirname "${p}")" && pwd)"
  printf '%s/%s\n' "${dir}" "$(basename "${p}")"
}

SELF_PATH="$(_resolve_self_path)"
REPO_ROOT="$(cd "$(dirname "${SELF_PATH}")" && pwd)"
# shellcheck source=scripts/lib/common.sh
source "${REPO_ROOT}/scripts/lib/common.sh"

