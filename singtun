require_sub_write_privilege() {
  if [[ "${SINGTUN_ALLOW_NONROOT_SUB:-false}" != "true" ]]; then
    require_root
  fi
}

next_auto_sub_name() {
  local idx=1 candidate u_var t_var
  while true; do
    candidate="sub-${idx}"
    u_var="$(sub_uuid_var_name "${candidate}")"
    t_var="$(sub_token_var_name "${candidate}")"
    if ! has_subscription "${candidate}" \
      && ! env_file_has_key "${u_var}" "${ENV_FILE}" \
      && ! env_file_has_key "${t_var}" "${ENV_FILE}"; then
      printf '%s' "${candidate}"
      return 0
    fi
    idx=$((idx + 1))
  done
}

serialize_sub_list() {
  local -a items=("$@")
  local joined="" item
  for item in "${items[@]}"; do
    [[ -z "${item}" ]] && continue
    if [[ -z "${joined}" ]]; then
      joined="${item}"
    else
      joined="${joined} ${item}"
    fi
  done
  printf '"%s"' "${joined}"
}

sync_runtime_after_sub_change() {
  if is_server_deployed; then
    log_info "正在同步更新 sing-box 入站配置（服务短暂重启约 1 秒，现有连接将自动重连）..."
    bash "${REPO_ROOT}/scripts/40-deploy-server.sh" --sync-singbox-only || return 1
    SINGTUN_DEFER_RELEASE_PRUNE=true bash "${REPO_ROOT}/scripts/50-gen-clients.sh" || return 1
  elif [[ -n "${SINGTUN_SUB_WEB_BASE_OVERRIDE:-}" ]]; then
    SINGTUN_DEFER_RELEASE_PRUNE=true bash "${REPO_ROOT}/scripts/50-gen-clients.sh" || return 1
  else
    bash "${REPO_ROOT}/scripts/50-gen-clients.sh" --local-only || return 1
    log_warn "检测到服务端尚未完成首次部署（sing-box 未启用）：已更新 ${ENV_FILE} 与本地配置，请运行 'sudo ./singtun deploy' 上线服务与公网订阅。"
  fi
  if [[ "${SINGTUN_FAIL_AFTER_SUB_SYNC:-false}" == "true" ]]; then
    log_error "注入测试故障：订阅同步完成后触发失败"
    return 1
  fi
  return 0
}

save_local_snapshot() {
  local snap_dir="$1"
  cp -a "${ENV_FILE}" "${snap_dir}/env"
  if [[ -f "${ENV_FILE}.bak" ]]; then
    cp -a "${ENV_FILE}.bak" "${snap_dir}/env.bak"
  fi
  if [[ -d "${PRIVATE_DIR}/out" ]]; then
    cp -a "${PRIVATE_DIR}/out" "${snap_dir}/out"
  fi

  local sub_web_base="${SINGTUN_SUB_WEB_BASE_OVERRIDE:-/var/lib/singtun}"
  local sub_web_link="${sub_web_base}/sub-web"
  local sub_rel_dir="${sub_web_base}/releases"
  : > "${snap_dir}/pre_releases.list"
  if [[ -d "${sub_rel_dir}" ]]; then
    local rel
    shopt -s nullglob
    for rel in "${sub_rel_dir}"/sub-web.*; do
      if [[ -d "${rel}" && ! -L "${rel}" ]]; then
        printf '%s\n' "${rel}" >> "${snap_dir}/pre_releases.list"
      fi
    done
    shopt -u nullglob
  fi
  if [[ -L "${sub_web_link}" ]]; then
    readlink "${sub_web_link}" > "${snap_dir}/sub_web_target"
  fi

  if is_server_deployed && [[ -d "/etc/sing-box" && -r "/etc/sing-box" ]]; then
    cp -a "/etc/sing-box" "${snap_dir}/singbox-etc"
  fi
}

restore_local_snapshot() {
  local snap_dir="$1"
  local ok="true"
  if ! cp -a "${snap_dir}/env" "${ENV_FILE}"; then
    ok="false"
  else
    _preserve_env_owner_and_mode "${ENV_FILE}" "${ENV_FILE}" || ok="false"
  fi
  if [[ -f "${snap_dir}/env.bak" ]]; then
    if ! cp -a "${snap_dir}/env.bak" "${ENV_FILE}.bak"; then
      ok="false"
    else
      _preserve_env_owner_and_mode "${ENV_FILE}" "${ENV_FILE}.bak" || ok="false"
    fi
  else
    rm -f "${ENV_FILE}.bak" || ok="false"
  fi
  rm -rf -- "${PRIVATE_DIR}/out" || ok="false"
  if [[ -d "${snap_dir}/out" ]]; then
    cp -a "${snap_dir}/out" "${PRIVATE_DIR}/out" || ok="false"
  fi
  [[ "${ok}" == "true" ]]
}

restore_sub_web_snapshot() {
  local snap_dir="$1"
  if [[ "${EUID:-$(id -u)}" -ne 0 && -z "${SINGTUN_SUB_WEB_BASE_OVERRIDE:-}" ]]; then
    return 0
  fi

  local sub_web_base="${SINGTUN_SUB_WEB_BASE_OVERRIDE:-/var/lib/singtun}"
  local sub_web_link="${sub_web_base}/sub-web"
  local sub_rel_dir="${sub_web_base}/releases"
  local ok="true"
  local old_target=""

  if [[ -f "${snap_dir}/sub_web_target" ]]; then
    old_target="$(<"${snap_dir}/sub_web_target")"
    if [[ -z "${old_target}" || ! -d "${old_target}" ]]; then
      log_error "回滚异常：事务前的公网订阅发布目录不存在 (${old_target:-empty})，无法恢复软链！"
      ok="false"
    else
      mkdir -p "${sub_web_base}" || ok="false"
      local tmp_link="${sub_web_base}/sub-web.rb.$$"
      if ! ln -sfn "${old_target}" "${tmp_link}" || ! mv -Tf "${tmp_link}" "${sub_web_link}"; then
        rm -f "${tmp_link}" 2>/dev/null || true
        log_error "回滚异常：无法将 ${sub_web_link} 原子切回 ${old_target}！"
        ok="false"
      fi
    fi
  else
    if [[ -L "${sub_web_link}" || -e "${sub_web_link}" ]]; then
      rm -rf -- "${sub_web_link}" || ok="false"
    fi
  fi

  # 仅清理本次失败事务中新建、未提交的 sub-web.* 目录，完整保留事务前已存在的目录
  if [[ -d "${sub_rel_dir}" ]]; then
    local -A pre_map=()
    local line=""
    if [[ -f "${snap_dir}/pre_releases.list" ]]; then
      while IFS= read -r line; do
        [[ -n "${line}" ]] && pre_map["${line}"]=1
      done < "${snap_dir}/pre_releases.list"
    fi
    local rel
    shopt -s nullglob
    for rel in "${sub_rel_dir}"/sub-web.*; do
      if [[ -d "${rel}" && ! -L "${rel}" && -z "${pre_map[${rel}]:-}" && "${rel}" != "${old_target}" ]]; then
        rm -rf -- "${rel}" || ok="false"
      fi
    done
    shopt -u nullglob
  fi

  [[ "${ok}" == "true" ]]
}

# 订阅变更事务封装（目录级物理快照 + 原软链直恢复 + 成功后收敛最近 2 个发布版本）
apply_sub_env_and_sync() {
  local op_label="$1"
  shift

  local snap_dir
  make_temp_dir snap_dir
  save_local_snapshot "${snap_dir}"

  env_file_apply_batch "${ENV_FILE}" "$@"
  load_env
  log_info "${op_label}"

  if ! ( sync_runtime_after_sub_change ); then
    log_error "订阅运行时同步或客户端校验失败，正在从事务快照直接恢复 ${ENV_FILE}、本地产物与原公网软链..."
    local rb_ok="true"
    restore_local_snapshot "${snap_dir}" || rb_ok="false"
    restore_sub_web_snapshot "${snap_dir}" || rb_ok="false"
    if ! ( load_env ); then
      rb_ok="false"
    else
      load_env
    fi
    if is_server_deployed; then
      if [[ -d "${snap_dir}/singbox-etc" ]]; then
        if ! rm -rf -- "/etc/sing-box" || ! cp -a "${snap_dir}/singbox-etc" "/etc/sing-box"; then
          rb_ok="false"
        fi
      fi
      if ! systemctl restart sing-box || ! systemctl is-active --quiet sing-box; then
        log_error "回滚异常：恢复 /etc/sing-box 后重启 sing-box 失败！"
        rb_ok="false"
      fi
    fi
    if [[ "${rb_ok}" != "true" ]]; then
      die "严重错误：订阅操作失败，且回滚过程中发生异常！请立即检查系统与订阅目录状态。"
    fi
    die "订阅操作失败，已完整回滚至操作前状态。"
  fi

  if [[ "${EUID:-$(id -u)}" -eq 0 || -n "${SINGTUN_SUB_WEB_BASE_OVERRIDE:-}" ]]; then
    bash "${REPO_ROOT}/scripts/50-gen-clients.sh" --finalize-releases
  fi
}

print_subscription_info() {
  local sub="$1"
  local qr_type="${2:-}"

  load_env
  if ! has_subscription "${sub}"; then
    die "订阅 '${sub}' 不存在（可执行 './singtun list' 查看当前列表）。"
  fi

  local uuid tok base_url v2ray_url sb_url mihomo_url sr_url vless_uri hy2_uri=""
  uuid="$(get_sub_uuid "${sub}")"
  tok="$(get_sub_token "${sub}")"
  base_url="$(build_sub_base_url "${tok}")"
  v2ray_url="${base_url}/v2ray"
  sb_url="${base_url}/sing-box.json"
  mihomo_url="${base_url}/mihomo.yaml"
  sr_url="${base_url}/shadowrocket.conf"
  vless_uri="$(build_vless_uri "${sub}" "${uuid}")"
  if [[ "${ENABLE_HY2:-false}" == "true" ]]; then
    hy2_uri="$(build_hy2_uri "${sub}" "${uuid}")"
  fi

  local sb_enc mihomo_enc v2ray_b64
  sb_enc="$(urlencode_str "${sb_url}")"
  mihomo_enc="$(urlencode_str "${mihomo_url}")"
  v2ray_b64="$(printf '%s' "${v2ray_url}" | base64 | tr -d '\n=')"

  printf '\n========================================================================\n'
  printf '订阅名称: %s  (公网托管: ENABLE_SUBSCRIPTION=%s | Hysteria2: ENABLE_HY2=%s)\n' "${sub}" "${ENABLE_SUBSCRIPTION:-true}" "${ENABLE_HY2:-false}"
  printf '本地备份: %s/out/%s/\n' "${PRIVATE_DIR}" "${sub}"
  printf '========================================================================\n'

  if [[ "${ENABLE_SUBSCRIPTION:-true}" == "true" ]]; then
    printf '\n[1] 通用节点订阅 (仅含节点，需配合客户端规则 — Shadowrocket / v2rayN Base64):\n    %s\n' "${v2ray_url}"
    printf '\n[2] sing-box 全托管远程配置 (全平台首选: Win SFW / Mac·iOS SFM / Android SFA >= %s / Linux):\n    %s\n' "${SINGBOX_CLIENT_COMPAT:-1.14}" "${sb_url}"
    printf '\n[3] Clash.Meta / mihomo 全托管远程配置 (Clash Verge Rev / FlClash / Stash):\n    %s\n' "${mihomo_url}"
    printf '\n[4] Shadowrocket 远程分流规则 (不含节点，iOS 小火箭需配合 [1] 一起导入):\n    %s\n' "${sr_url}"

    printf '\n[客户端一键唤起深链]\n'
    printf '  - sing-box 官方客户端 : sing-box://import-remote-profile?url=%s#%s-%s\n' "${sb_enc}" "${SERVER_DOMAIN}" "${sub}"
    printf '  - Clash Verge / Stash : clash://install-config?url=%s&name=%s-%s\n' "${mihomo_enc}" "${SERVER_DOMAIN}" "${sub}"
    printf '  - Shadowrocket 节点   : sub://%s#%s-%s\n' "${v2ray_b64}" "${SERVER_DOMAIN}" "${sub}"
    printf '  - Shadowrocket 规则   : shadowrocket://config/add/%s\n' "${sr_url}"
  else
    printf '\n[提示] 当前 ENABLE_SUBSCRIPTION=false，未开放公网 HTTPS 订阅链接；请从本地目录取回配置文件。\n'
  fi

  printf '\n[兜底原始节点链接]\n  - VLESS REALITY Vision:\n    %s\n' "${vless_uri}"
  if [[ -n "${hy2_uri}" ]]; then
    printf '  - Hysteria2 (QUIC 备用):\n    %s\n' "${hy2_uri}"
  fi
  printf '\n[安全提醒] 订阅链接包含完整节点凭据，切勿截图、公开粘贴或转发他人！\n'
  printf '           一旦怀疑链接泄露，请立即执行: sudo ./singtun reset %s\n' "${sub}"
  printf '           如需终端扫码，可追加参数: --qr v2ray | singbox | mihomo | sr | vless | hy2\n'
  printf '========================================================================\n'

  if [[ -n "${qr_type}" ]]; then
    require_cmd qrencode
    local qr_target="" qr_label=""
    case "${qr_type}" in
      v2ray)
        qr_target="${v2ray_url}"
        qr_label="通用节点订阅 (v2ray Base64)"
        ;;
      singbox|sing-box)
        qr_target="${sb_url}"
        qr_label="sing-box 远程配置 (JSON)"
        ;;
      mihomo|clash)
        qr_target="${mihomo_url}"
        qr_label="Clash.Meta / mihomo 远程配置 (YAML)"
        ;;
      sr|shadowrocket)
        qr_target="${sr_url}"
        qr_label="Shadowrocket 远程分流配置 (.conf)"
        ;;
      vless)
        qr_target="${vless_uri}"
        qr_label="原始单节点链接 (vless://)"
        ;;
      hy2|hysteria2)
        if [[ -z "${hy2_uri}" ]]; then
          die "当前 ENABLE_HY2=false，未启用 Hysteria2 节点，无法生成 '--qr hy2' 二维码。"
        fi
        qr_target="${hy2_uri}"
        qr_label="原始单节点链接 (hysteria2://)"
        ;;
      *)
        die "未知的 --qr 类型 '${qr_type}'（支持: v2ray | singbox | mihomo | sr | vless | hy2）"
        ;;
    esac
    if [[ "${ENABLE_SUBSCRIPTION:-true}" != "true" && "${qr_type}" != "vless" && "${qr_type}" != "hy2" && "${qr_type}" != "hysteria2" ]]; then
      die "当前 ENABLE_SUBSCRIPTION=false，仅支持 '--qr vless' 或 '--qr hy2' 输出离线节点二维码。"
    fi
    log_info "订阅 [${sub}] — ${qr_label} 二维码:"
    printf '%s' "${qr_target}" | qrencode -t ANSIUTF8
  fi
}

parse_sub_name_and_qr() {
  SUB_PARSED_NAME=""
  SUB_PARSED_QR=""
  while (( $# > 0 )); do
    case "$1" in
      --qr)
        [[ $# -ge 2 ]] || die "--qr 参数缺少类型值（支持: v2ray | singbox | mihomo | sr | vless | hy2）"
        SUB_PARSED_QR="$2"
        shift 2
        ;;
      --qr=*)
        SUB_PARSED_QR="${1#--qr=}"
        shift
        ;;
      -*)
        die "未知选项: $1"
        ;;
      *)
        if [[ -n "${SUB_PARSED_NAME}" ]]; then
          die "多余的位置参数: $1"
        fi
        SUB_PARSED_NAME="$1"
        shift
        ;;
    esac
  done
}

cmd_add() {
  require_sub_write_privilege
  acquire_singtun_lock
  load_env

  parse_sub_name_and_qr "$@"
  local name="${SUB_PARSED_NAME}"
  local qr_type="${SUB_PARSED_QR}"

  if [[ -z "${name}" ]]; then
    name="$(next_auto_sub_name)"
  fi

  if is_reserved_sub_name "${name}"; then
    die "订阅名 '${name}' 为系统保留字，请换用其他名称（如 iphone、macbook、sub-1）。"
  fi
  if ! is_valid_sub_name "${name}"; then
    die "订阅名 '${name}' 格式非法（仅允许小写字母、数字与非首尾短横线，长度 1-32）。"
  fi
  if has_subscription "${name}"; then
    die "订阅 '${name}' 已存在！如需查看链接请执行 './singtun show ${name}'，如需重置凭据请执行 'sudo ./singtun reset ${name}'。"
  fi

  local u_var t_var
  u_var="$(sub_uuid_var_name "${name}")"
  t_var="$(sub_token_var_name "${name}")"
  if env_file_has_key "${u_var}" "${ENV_FILE}" || env_file_has_key "${t_var}" "${ENV_FILE}"; then
    die "检测到 ${ENV_FILE} 中已存在孤立变量 ${u_var} 或 ${t_var}（不属于当前活跃订阅），为防凭据冲突已中止，请先清理该旧变量！"
  fi

  local new_uuid new_tok
  new_uuid="$(generate_uuid)"
  new_tok="$(generate_sub_token)"

  local -a subs=()
  local s
  while IFS= read -r s; do
    [[ -n "${s}" ]] && subs+=("${s}")
  done < <(list_subscriptions)
  subs+=("${name}")

  local serialized
  serialized="$(serialize_sub_list "${subs[@]}")"
  apply_sub_env_and_sync \
    "已创建新订阅 [${name}] 并分配独立 UUID 与 256-bit 订阅令牌。" \
    "SET:SUBSCRIPTIONS=${serialized}" \
    "SET:${u_var}=${new_uuid}" \
    "SET:${t_var}=${new_tok}"
  print_subscription_info "${name}" "${qr_type}"
}

cmd_list() {
  assert_no_args "list" "$@"
  load_env
  local count=0 s
  printf '公网订阅托管开关: ENABLE_SUBSCRIPTION=%s\n' "${ENABLE_SUBSCRIPTION:-true}"
  printf '当前订阅列表:\n'
  while IFS= read -r s; do
    [[ -z "${s}" ]] && continue
    count=$((count + 1))
    printf '  %d. %s\n' "${count}" "${s}"
  done < <(list_subscriptions)

  if (( count == 0 )); then
    printf '  (空 — 可通过 "sudo ./singtun add [name]" 按需创建新订阅)\n'
  fi
}

cmd_show() {
  parse_sub_name_and_qr "$@"
  [[ -n "${SUB_PARSED_NAME}" ]] || die "用法: ./singtun show <name> [--qr <v2ray|singbox|mihomo|sr|vless|hy2>]"
  print_subscription_info "${SUB_PARSED_NAME}" "${SUB_PARSED_QR}"
}

cmd_reset() {
  require_sub_write_privilege
  acquire_singtun_lock
  load_env

  parse_sub_name_and_qr "$@"
  local name="${SUB_PARSED_NAME}"
  local qr_type="${SUB_PARSED_QR}"
  [[ -n "${name}" ]] || die "用法: sudo ./singtun reset <name> [--qr <v2ray|singbox|mihomo|sr|vless|hy2>]"

  if ! has_subscription "${name}"; then
    die "订阅 '${name}' 不存在，无法重置。"
  fi

  local old_uuid old_tok new_uuid new_tok u_var t_var
  old_uuid="$(get_sub_uuid "${name}")"
  old_tok="$(get_sub_token "${name}")"
  u_var="$(sub_uuid_var_name "${name}")"
  t_var="$(sub_token_var_name "${name}")"

  new_uuid="$(generate_uuid)"
  while [[ "${new_uuid}" == "${old_uuid}" ]]; do
    new_uuid="$(generate_uuid)"
  done

  new_tok="$(generate_sub_token)"
  while [[ "${new_tok}" == "${old_tok}" ]]; do
    new_tok="$(generate_sub_token)"
  done

  apply_sub_env_and_sync \
    "已重置订阅 [${name}] 的 UUID 与 256-bit 订阅令牌（旧节点与旧订阅 URL 即将同时失效）。" \
    "SET:${u_var}=${new_uuid}" \
    "SET:${t_var}=${new_tok}"
  print_subscription_info "${name}" "${qr_type}"
}

cmd_del() {
  require_sub_write_privilege
  acquire_singtun_lock
  load_env

  local name="${1:-}"
  [[ -n "${name}" && "${name}" != -* ]] || die "用法: sudo ./singtun del <name>"
  if (( $# > 1 )); then
    die "多余的参数: $2（用法: sudo ./singtun del <name>）"
  fi

  if ! has_subscription "${name}"; then
    die "订阅 '${name}' 不存在，无需删除。"
  fi

  local -a kept=()
  local s
  while IFS= read -r s; do
    [[ -n "${s}" && "${s}" != "${name}" ]] && kept+=("${s}")
  done < <(list_subscriptions)

  local serialized u_var t_var
  if (( ${#kept[@]} == 0 )); then
    serialized='""'
  else
    serialized="$(serialize_sub_list "${kept[@]}")"
  fi
  u_var="$(sub_uuid_var_name "${name}")"
  t_var="$(sub_token_var_name "${name}")"

  apply_sub_env_and_sync \
    "已从配置中吊销订阅 [${name}]。" \
    "SET:SUBSCRIPTIONS=${serialized}" \
    "DEL:${u_var}" \
    "DEL:${t_var}"
  log_info "订阅 [${name}] 已彻底删除（服务端入站、公网链接与本地目录均已清理）。"
}

prepare_check_cert_dir() {
  local cert_dir="$1"
  mkdir -p "${cert_dir}"
  if command -v openssl >/dev/null 2>&1; then
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 \
      -keyout "${cert_dir}/key.pem" \
      -out "${cert_dir}/fullchain.pem" \
      -days 1 -nodes -subj "/CN=${SERVER_DOMAIN}" >/dev/null 2>&1
  fi
}

cmd_check() {
  assert_no_args "check" "$@"
  load_env
  require_cmd jq base64

  # 1. 运行当前配置的预检（跳过宿主 OS、公网 DNS 与端口占用检查）
  SKIP_OS_CHECK=true SKIP_DNS_CHECK=true SKIP_PORT_CHECK=true \
    bash "${REPO_ROOT}/scripts/00-preflight.sh"

  # 2. 校验当前 .env 渲染出的服务端配置与 Nginx 配置
  local tmp_srv_dir tmp_priv_dir
  make_temp_dir tmp_srv_dir
  make_temp_dir tmp_priv_dir

  prepare_check_cert_dir "${tmp_srv_dir}/cert"
  SINGTUN_CERT_DIR_OVERRIDE="${tmp_srv_dir}/cert" SINGTUN_WEB_ROOT_OVERRIDE="${tmp_srv_dir}/www" \
    bash "${REPO_ROOT}/scripts/40-deploy-server.sh" --render-only "${tmp_srv_dir}"

  local f
  for f in "${tmp_srv_dir}"/singbox/*.json; do
    jq empty "${f}"
  done

  local sb_bin="${SINGTUN_SINGBOX_BIN:-}"
  if [[ -n "${sb_bin}" ]]; then
    [[ -x "${sb_bin}" ]] || die "指定的 SINGTUN_SINGBOX_BIN 不可执行: ${sb_bin}"
  elif command -v sing-box >/dev/null 2>&1; then
    sb_bin="$(command -v sing-box)"
  fi

  if [[ -n "${sb_bin}" ]]; then
    local sb_out=""
    if ! sb_out="$("${sb_bin}" check -C "${tmp_srv_dir}/singbox" 2>&1)"; then
      log_error "${sb_out}"
      die "服务端配置未通过 sing-box check 校验！"
    fi
    if grep -Eiq '(deprecated|warn)' <<< "${sb_out}"; then
      log_error "${sb_out}"
      die "服务端配置存在 sing-box 弃用或警告项！"
    fi
    log_info "服务端配置通过 sing-box check 校验（零弃用警告）。"
  else
    log_warn "本机未安装 sing-box，服务端配置已完成 JSON 结构校验（跳过 sing-box check）。"
  fi

  validate_nginx_rendered_config "${tmp_srv_dir}"

  # 3. 在隔离临时目录校验当前 .env 下的全部 4 种客户端配置（若无活跃订阅则注入临时探测订阅）
  cp "${ENV_FILE}" "${tmp_priv_dir}/.env"
  chmod 600 "${tmp_priv_dir}/.env"

  if [[ -z "$(list_subscriptions)" ]]; then
    local probe_uuid probe_tok
    probe_uuid="$(generate_uuid)"
    probe_tok="$(generate_sub_token)"
    SINGTUN_ENV_FILE="${tmp_priv_dir}/.env" env_file_apply_batch "${tmp_priv_dir}/.env" \
      'SET:SUBSCRIPTIONS="check-probe"' \
      "SET:UUID_CHECK_PROBE=${probe_uuid}" \
      "SET:SUB_TOKEN_CHECK_PROBE=${probe_tok}"
  fi

  SINGTUN_PRIVATE_DIR="${tmp_priv_dir}" SINGTUN_ENV_FILE="${tmp_priv_dir}/.env" SINGTUN_SINGBOX_BIN="${sb_bin}" \
    bash "${REPO_ROOT}/scripts/50-gen-clients.sh" --local-only

  for f in "${tmp_priv_dir}"/out/*/sing-box.json; do
    jq empty "${f}"
  done

  for f in "${tmp_priv_dir}"/out/*/mihomo.yaml "${tmp_priv_dir}"/out/*/shadowrocket.conf; do
    assert_no_unreplaced_placeholders "${f}"
  done

  for f in "${tmp_priv_dir}"/out/*/v2ray; do
    local decoded
    decoded="$(base64 -d < "${f}")"
    if [[ "${decoded}" != vless://* ]]; then
      die "Base64 节点订阅解码内容异常: ${f}"
    fi
  done

  rm -rf "${tmp_srv_dir}" "${tmp_priv_dir}"
  log_info "singtun check 全部校验通过！"
}

check_cert_status() {
  local cert_file="/etc/singtun/cert/fullchain.pem"
  local end_raw=""

  if [[ -r "${cert_file}" ]] && command -v openssl >/dev/null 2>&1; then
    end_raw="$(openssl x509 -in "${cert_file}" -noout -enddate 2>/dev/null || true)"
  elif command -v openssl >/dev/null 2>&1 && [[ -r "${ENV_FILE}" ]]; then
    load_env
    if [[ -n "${REALITY_HANDSHAKE_PORT:-}" && -n "${SERVER_DOMAIN:-}" ]]; then
      end_raw="$(openssl s_client -connect "127.0.0.1:${REALITY_HANDSHAKE_PORT}" -servername "${SERVER_DOMAIN}" </dev/null 2>/dev/null \
        | openssl x509 -noout -enddate 2>/dev/null || true)"
    fi
  fi

  if [[ -z "${end_raw}" ]]; then
    log_warn "未能读取 TLS 证书到期时间（建议使用 'sudo ./singtun status' 检查 ${cert_file}）。"
    return 0
  fi

  local end_date="${end_raw#notAfter=}"
  local exp_epoch="" now_epoch=""
  exp_epoch="$(date -d "${end_date}" +%s 2>/dev/null || true)"
  now_epoch="$(date +%s)"

  if [[ -z "${exp_epoch}" ]]; then
    log_info "TLS 证书到期时间: ${end_date}"
    return 0
  fi

  local days_left=$(( (exp_epoch - now_epoch) / 86400 ))
  if (( days_left < 0 )); then
    log_error "TLS 证书已过期 $(( -days_left )) 天 (到期时间: ${end_date})！回落站点将暴露异常特征，请立即检查 CF_API_TOKEN 并运行 'sudo ./singtun renew'！"
    return 1
  elif (( days_left < 20 )); then
    log_warn "TLS 证书剩余有效期不足 20 天：仅剩 ${days_left} 天 (${end_date})！自动续期可能已失败，请检查 CF_API_TOKEN 并运行 'sudo ./singtun renew'。"
  else
    log_info "TLS 证书状态正常：剩余 ${days_left} 天到期 (${end_date})。"
  fi
}

cmd_status() {
  assert_no_args "status" "$@"
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    log_warn "当前未以 root 权限运行，可能无法查看完整服务日志与磁盘证书；建议使用: sudo ./singtun status"
  fi
  local svc_rc=0 cert_rc=0
  local -a units=("sing-box" "nginx")
  if [[ -f "/etc/systemd/system/singtun-vless-guard.service" ]] || systemctl is-active --quiet singtun-vless-guard.service 2>/dev/null; then
    units+=("singtun-vless-guard")
  fi
  if [[ -f "/etc/systemd/system/singtun-hy2-hop.service" ]] || systemctl is-active --quiet singtun-hy2-hop.service 2>/dev/null; then
    units+=("singtun-hy2-hop")
  fi
  systemctl status "${units[@]}" --no-pager || svc_rc=$?
  echo ""
  check_cert_status || cert_rc=$?
  if (( svc_rc != 0 )); then
    return "${svc_rc}"
  fi
  return "${cert_rc}"
}

cmd_logs() {
  assert_no_args "logs" "$@"
  if [[ "${EUID:-$(id -u)}" -ne 0 ]]; then
    log_warn "当前未以 root 权限运行，普通用户通常无法读取 systemd 服务日志；若输出为空请使用: sudo ./singtun logs"
  fi
  journalctl -u sing-box -u nginx -f
}

cmd_restart() {
  assert_no_args "restart" "$@"
  require_root
  acquire_singtun_lock
  systemctl restart nginx sing-box
  sleep 1
  if ! systemctl is-active --quiet nginx || ! systemctl is-active --quiet sing-box; then
    die "重启后 Nginx 或 sing-box 未处于 active 状态，请运行 'sudo ./singtun status' 与 'sudo ./singtun logs' 排查！"
  fi
  if [[ -f "/etc/systemd/system/singtun-vless-guard.service" ]] && systemctl is-enabled --quiet singtun-vless-guard.service 2>/dev/null; then
    systemctl restart singtun-vless-guard.service
  fi
  if [[ -f "/etc/systemd/system/singtun-hy2-hop.service" ]] && systemctl is-enabled --quiet singtun-hy2-hop.service 2>/dev/null; then
    systemctl restart singtun-hy2-hop.service
  fi
  log_info "Nginx 与 sing-box 已重启并通过活跃状态校验。"
}

cmd_renew() {
  assert_no_args "renew" "$@"
  require_root
  acquire_singtun_lock
  bash "${REPO_ROOT}/scripts/30-cert.sh" --force
}

cmd_upgrade() {
  local raw_ver="${1:-}"
  [[ -n "${raw_ver}" ]] || die "用法: sudo ./singtun upgrade <version>"
  if (( $# > 1 )); then
    die "多余的参数: $2（用法: sudo ./singtun upgrade <version>）"
  fi

  local target_ver="${raw_ver#v}"
  if ! is_valid_semver "${target_ver}"; then
    die "目标版本格式非法（须形如 x.y.z 或 vx.y.z）: ${raw_ver}"
  fi

  if [[ "${SINGTUN_ALLOW_NONROOT_UPGRADE_TEST:-false}" != "true" ]]; then
    require_root
  fi
  acquire_singtun_lock
  load_env

  local old_env_ver="${SINGBOX_VERSION:-}"
  local old_bin_ver="" old_bin_path=""
  if command -v sing-box >/dev/null 2>&1; then
    old_bin_path="$(command -v sing-box)"
    old_bin_ver="$(sing-box version 2>/dev/null | awk '/^sing-box version/ {print $3}' || true)"
  fi

  local singbox_etc_dir="/etc/sing-box"
  local snap_dir stage_dir had_etc="false"
  make_temp_dir snap_dir
  make_temp_dir stage_dir
  save_local_snapshot "${snap_dir}"
  if [[ -n "${old_bin_path}" && -f "${old_bin_path}" ]]; then
    cp -a "${old_bin_path}" "${snap_dir}/sing-box.bin"
  fi
  if [[ -d "${singbox_etc_dir}" && -r "${singbox_etc_dir}" ]]; then
    cp -a "${singbox_etc_dir}" "${snap_dir}/singbox-etc"
    had_etc="true"
  fi

  log_info "开始执行 sing-box 版本升级/切换: ${old_env_ver:-?} (当前二进制: ${old_bin_ver:-未安装}) -> ${target_ver}"

  local upgrade_ok="true"
  # 1. 先在隔离目录暂存候选版本 deb 与二进制（不替换运行中二进制、不重启旧配置）
  if ! ( bash "${REPO_ROOT}/scripts/40-deploy-server.sh" --stage-singbox "${target_ver}" "${stage_dir}" ); then
    upgrade_ok="false"
  fi

  # 2. 更新版本号并用暂存的目标版本二进制（独立子进程完整启用 set -e）离线校验服务端与客户端渲染配置
  if [[ "${upgrade_ok}" == "true" ]]; then
    env_file_set_var "SINGBOX_VERSION" "${target_ver}" "${ENV_FILE}"
    load_env
    if ! SINGTUN_SINGBOX_BIN="${stage_dir}/rootfs/usr/bin/sing-box" bash "${REPO_ROOT}/singtun" check; then
      upgrade_ok="false"
    fi
  fi

  # 3. 校验全部通过后，安装暂存二进制并原子更新服务端与公网订阅
  if [[ "${upgrade_ok}" == "true" ]]; then
    if [[ "${SINGTUN_ALLOW_NONROOT_UPGRADE_TEST:-false}" == "true" ]]; then
      if ! ( SINGTUN_SINGBOX_BIN="${stage_dir}/rootfs/usr/bin/sing-box" SINGTUN_DEFER_RELEASE_PRUNE=true bash "${REPO_ROOT}/scripts/50-gen-clients.sh" ); then
        upgrade_ok="false"
      fi
    elif is_server_deployed; then
      if ! ( SINGTUN_DEFER_RELEASE_PRUNE=true bash "${REPO_ROOT}/scripts/40-deploy-server.sh" --upgrade-singbox "${stage_dir}/sing-box.deb" ); then
        upgrade_ok="false"
      fi
    else
      if ! ( bash "${REPO_ROOT}/scripts/40-deploy-server.sh" --upgrade-singbox "${stage_dir}/sing-box.deb" ); then
        upgrade_ok="false"
      fi
    fi
  fi

  if [[ "${upgrade_ok}" != "true" ]]; then
    log_error "升级至 sing-box ${target_ver} 失败，正在从快照回滚配置、软链与二进制版本..."
    local rb_ok="true"
    restore_local_snapshot "${snap_dir}" || rb_ok="false"
    restore_sub_web_snapshot "${snap_dir}" || rb_ok="false"
    if [[ "${had_etc}" == "true" && "${EUID:-$(id -u)}" -eq 0 ]]; then
      if ! rm -rf -- "${singbox_etc_dir}" || ! cp -a "${snap_dir}/singbox-etc" "${singbox_etc_dir}"; then
        rb_ok="false"
      fi
    fi
    if ! ( load_env ); then
      rb_ok="false"
    else
      load_env
    fi

    if [[ "${EUID:-$(id -u)}" -eq 0 && -n "${old_bin_ver}" ]]; then
      local cur_bin_ver=""
      if command -v sing-box >/dev/null 2>&1; then
        cur_bin_ver="$(sing-box version 2>/dev/null | awk '/^sing-box version/ {print $3}' || true)"
      fi
      if [[ "${cur_bin_ver}" != "${old_bin_ver}" ]]; then
        log_info "正在将 sing-box 二进制版本回滚至 ${old_bin_ver}..."
        bash "${REPO_ROOT}/scripts/40-deploy-server.sh" --install-singbox-version "${old_bin_ver}" || true
        cur_bin_ver=""
        if command -v sing-box >/dev/null 2>&1; then
          cur_bin_ver="$(sing-box version 2>/dev/null | awk '/^sing-box version/ {print $3}' || true)"
        fi
        if [[ "${cur_bin_ver}" != "${old_bin_ver}" && -f "${snap_dir}/sing-box.bin" ]]; then
          log_warn "包管理器未能降级至 ${old_bin_ver}，正在从物理快照直接还原 sing-box 二进制..."
          if ! install -m 755 -o root -g root "${snap_dir}/sing-box.bin" "${old_bin_path:-/usr/bin/sing-box}"; then
            rb_ok="false"
          fi
          if command -v apt-mark >/dev/null 2>&1; then
            apt-mark hold sing-box >/dev/null 2>&1 || true
          fi
        fi
        cur_bin_ver="$(sing-box version 2>/dev/null | awk '/^sing-box version/ {print $3}' || true)"
        if [[ "${cur_bin_ver}" != "${old_bin_ver}" ]]; then
          log_error "回滚异常：无法将 sing-box 二进制恢复至 ${old_bin_ver}（当前: ${cur_bin_ver:-?}）！"
          rb_ok="false"
        fi
      fi
    fi
    if is_server_deployed; then
      if ! systemctl restart sing-box || ! systemctl is-active --quiet sing-box; then
        log_error "回滚异常：恢复旧版本后重启 sing-box 失败！"
        rb_ok="false"
      fi
    fi
    if [[ "${rb_ok}" != "true" ]]; then
      die "严重错误：sing-box 升级至 ${target_ver} 失败，且回滚过程中发生异常！请立即检查系统状态。"
    fi
    die "sing-box 升级至 ${target_ver} 失败，已完整回滚至升级前状态 (${old_env_ver:-?})。"
  fi

  if [[ "${EUID:-$(id -u)}" -eq 0 || -n "${SINGTUN_SUB_WEB_BASE_OVERRIDE:-}" ]]; then
    bash "${REPO_ROOT}/scripts/50-gen-clients.sh" --finalize-releases
  fi
  log_info "sing-box 已成功升级/同步至版本 ${target_ver}！"
}

collect_singtun_ufw_rules_to_delete() {
  awk '
    /# singtun-(vless-reality|hy2|hy2-hop)([[:space:]]|$)/ && $1 ~ /^[0-9]+(:[0-9]+)?\/(tcp|udp)$/ {
      print $1
    }
  ' | sort -u
}

cmd_uninstall() {
  local purge_cert="false"
  while (( $# > 0 )); do
    case "$1" in
      --purge-cert)
        purge_cert="true"
        shift
        ;;
      *)
        die "未知选项: $1（用法: sudo ./singtun uninstall [--purge-cert]）"
        ;;
    esac
  done

  require_root
  acquire_singtun_lock
  if [[ -f "${ENV_FILE}" ]]; then
    load_env
  fi

  log_info "开始卸载 singtun 服务端组件（保留 ${PRIVATE_DIR}/ 目录）..."

  # 1. 停止并禁用 systemd 服务，移除覆盖配置与版本锁定
  local override_dir="/etc/systemd/system/sing-box.service.d"
  local ng_override_dir="/etc/systemd/system/nginx.service.d"
  local guard_unit="/etc/systemd/system/singtun-vless-guard.service"
  local guard_nft="/etc/singtun/vless-guard.nft"
  local hy2_unit="/etc/systemd/system/singtun-hy2-hop.service"
  local hy2_nft="/etc/singtun/hy2-hop.nft"

  if command -v systemctl >/dev/null 2>&1; then
    systemctl disable --now sing-box >/dev/null 2>&1 || true
    systemctl disable --now singtun-vless-guard.service >/dev/null 2>&1 || true
    systemctl disable --now singtun-hy2-hop.service >/dev/null 2>&1 || true
  fi
  rm -f "${override_dir}/override.conf" "${ng_override_dir}/singtun.conf" "${guard_unit}" "${guard_nft}" "${hy2_unit}" "${hy2_nft}"
  rmdir "${override_dir}" "${ng_override_dir}" 2>/dev/null || true
  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
  fi
  if command -v apt-mark >/dev/null 2>&1; then
    apt-mark unhold sing-box >/dev/null 2>&1 || true
  fi

  # 2. 移除服务端 sing-box 配置、Nginx 回落站点/调优项与公网静态订阅目录
  local singbox_etc="/etc/sing-box"
  local nginx_avail="/etc/nginx/sites-available/singtun-reality.conf"
  local nginx_en="/etc/nginx/sites-enabled/singtun-reality.conf"
  local nginx_tuning="/etc/nginx/modules-enabled/99-singtun-tuning.conf"
  local nginx_main="/etc/nginx/nginx.conf"
  local web_root="/var/www/singtun-site"
  local sub_web_base="/var/lib/singtun"

  rm -f "${singbox_etc}"/*.json 2>/dev/null || true
  rmdir "${singbox_etc}" 2>/dev/null || true
  rm -f "${nginx_en}" "${nginx_avail}" "${nginx_tuning}"
  if [[ -f "${nginx_main}" ]] && grep -Fq '# singtun-tuned-from-768' "${nginx_main}"; then
    sed -i -E 's/^([[:space:]]*)worker_connections[[:space:]]+[0-9]+;[[:space:]]*#[[:space:]]*singtun-tuned-from-768$/\1worker_connections 768;/' "${nginx_main}"
  fi
  rm -rf "${web_root}" "${web_root}.singtun-new" "${web_root}.singtun-old" "${sub_web_base}"

  if command -v nginx >/dev/null 2>&1; then
    if systemctl is-active --quiet nginx 2>/dev/null && nginx -t >/dev/null 2>&1; then
      systemctl reload nginx >/dev/null 2>&1 || true
    fi
  fi

  # 3. 清理 nftables 保护/端口跳跃表与 UFW 代理放行规则（严格保留 singtun-preserve-ssh）
  if command -v nft >/dev/null 2>&1; then
    if nft list table inet singtun_guard >/dev/null 2>&1; then
      nft delete table inet singtun_guard >/dev/null 2>&1 || true
      log_info "已移除 nftables 连接保护表 (inet singtun_guard)。"
    fi
    if nft list table inet singtun_hy2 >/dev/null 2>&1; then
      nft delete table inet singtun_hy2 >/dev/null 2>&1 || true
      log_info "已移除 nftables 端口跳跃表 (inet singtun_hy2)。"
    fi
  fi

  if command -v ufw >/dev/null 2>&1; then
    local -A active_ssh_tcp=()
    local sp
    while IFS= read -r sp; do
      [[ -n "${sp}" ]] && active_ssh_tcp["${sp}/tcp"]=1
    done < <(detect_active_ssh_ports)
    local rule_spec
    while IFS= read -r rule_spec; do
      [[ -z "${rule_spec}" ]] && continue
      if [[ -n "${active_ssh_tcp[${rule_spec}]:-}" ]]; then
        log_warn "跳过删除当前活跃 SSH 监听端口对应的 UFW 规则: ${rule_spec}"
        continue
      fi
      ufw delete allow "${rule_spec}" >/dev/null 2>&1 || true
      log_info "已移除 UFW 放行规则: ${rule_spec}"
    done < <(ufw status 2>/dev/null | collect_singtun_ufw_rules_to_delete || true)
  fi

  # 4. 清理内核调优配置、journald 限额、遗留文件与证书重载钩子（默认保留证书，支持 --purge-cert 彻底删除）
  rm -f \
    "/etc/singtun/ssh_port" \
    "/etc/sysctl.d/99-singtun.conf" \
    "/etc/security/limits.d/99-singtun.conf" \
    "/etc/modules-load.d/singtun-bbr.conf" \
    "/etc/systemd/journald.conf.d/99-singtun.conf" \
    "/usr/local/libexec/singtun-cert-reload"
  rmdir "/etc/systemd/journald.conf.d" 2>/dev/null || true

  if command -v sysctl >/dev/null 2>&1; then
    sysctl --system >/dev/null 2>&1 || true
  fi

  local cert_dir="/etc/singtun/cert"
  if [[ "${purge_cert}" == "true" ]]; then
    if [[ -n "${SERVER_DOMAIN:-}" && -x "/root/.acme.sh/acme.sh" ]]; then
      env -u SUDO_USER -u SUDO_UID -u SUDO_GID -u SUDO_COMMAND HOME="/root" \
        /root/.acme.sh/acme.sh --home "/root/.acme.sh" --remove -d "${SERVER_DOMAIN}" --ecc >/dev/null 2>&1 || true
    fi
    rm -rf "${cert_dir}"
    rmdir "/etc/singtun" 2>/dev/null || true
    log_info "已按 --purge-cert 清理 TLS 证书目录 (${cert_dir})。"
  else
    rmdir "/etc/singtun" 2>/dev/null || true
    if [[ -d "${cert_dir}" ]]; then
      log_info "已保留 TLS 证书 (${cert_dir}) 以免重新部署触发 Let's Encrypt 速率限制；如需彻底删除可加 '--purge-cert'。"
    fi
  fi

  log_info "卸载完成！私有配置与客户端备份已完整保留于: ${PRIVATE_DIR}/"
}

_setup_is_doc_ipv4() {
  case "$1" in
    192.0.2.*|198.51.100.*|203.0.113.*) return 0 ;;
    *) return 1 ;;
  esac
}

_setup_trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "${s}"
}

_setup_read_line() {
  local input_fd="$1"
  local prompt="$2"
  local secret="${3:-false}"
  local out_var="$4"
  local -a read_flags=(-u "${input_fd}")

  printf '%s' "${prompt}" >&2
  if [[ "${secret}" == "true" && -t "${input_fd}" ]]; then
    read_flags+=(-s)
  fi

  local val=""
  if ! IFS= read -r "${read_flags[@]}" val; then
    if [[ "${secret}" == "true" && -t "${input_fd}" ]]; then
      printf '\n' >&2
    fi
    return 1
  fi
  if [[ "${secret}" == "true" && -t "${input_fd}" ]]; then
    printf '\n' >&2
  fi
  printf -v "${out_var}" '%s' "${val}"
  return 0
}

_setup_prompt_validated() {
  local input_fd="$1"
  local label="$2"
  local default_val="$3"
  local validator_fn="$4"
  local err_msg="$5"
  local out_var="$6"
  local lower="${7:-false}"
  local prompt_str raw

  if [[ -n "${default_val}" ]]; then
    prompt_str="${label} [${default_val}]: "
  else
    prompt_str="${label}: "
  fi

  while true; do
    _setup_read_line "${input_fd}" "${prompt_str}" "false" raw \
      || die "交互输入已结束，已中止 setup。"
    raw="$(_setup_trim "${raw}")"
    if [[ -z "${raw}" ]]; then
      raw="${default_val}"
    fi
    if [[ "${lower}" == "true" ]]; then
      raw="$(printf '%s' "${raw}" | tr '[:upper:]' '[:lower:]')"
    fi
    if "${validator_fn}" "${raw}"; then
      printf -v "${out_var}" '%s' "${raw}"
      return 0
    fi
    log_warn "${err_msg}"
  done
}

_setup_prompt_yn() {
  local input_fd="$1"
  local prompt="$2"
  local default_yn="$3"
  local ans
  while true; do
    _setup_read_line "${input_fd}" "${prompt}" "false" ans \
      || die "交互输入已结束，已中止 setup。"
    ans="$(_setup_trim "${ans}" | tr '[:upper:]' '[:lower:]')"
    [[ -z "${ans}" ]] && ans="${default_yn}"
    case "${ans}" in
      y|yes) return 0 ;;
      n|no)  return 1 ;;
      *) log_warn "请输入 y 或 n。" ;;
    esac
  done
}

_setup_valid_domain_input() {
  local d="$1"
  is_valid_domain "${d}" && ! is_reserved_example_domain "${d}"
}

_setup_valid_public_ip_input() {
  local ip="$1"
  is_valid_ipv4 "${ip}" || return 1
  ! is_non_public_ipv4 "${ip}" || return 1
  if [[ "${SINGTUN_SETUP_ALLOW_DOC_IP:-false}" != "true" ]] && _setup_is_doc_ipv4 "${ip}"; then
    return 1
  fi
  return 0
}

_setup_valid_email_input() {
  local email="$1"
  is_valid_email "${email}" && ! is_reserved_example_email "${email}"
}

_setup_valid_port_range_opt() {
  local r="$1"
  [[ -z "${r}" ]] || is_valid_port_range "${r}"
}

_setup_valid_pos_int_opt() {
  local n="$1"
  [[ -z "${n}" || "${n}" =~ ^[1-9][0-9]*$ ]]
}

_setup_valid_sb_ver() {
  local v="$1"
  [[ "${v}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][A-Za-z0-9]+)*$ ]]
}

_setup_resolve_a_records() {
  local domain="$1"
  local out=""
  if command -v dig >/dev/null 2>&1; then
    out="$(dig +short +time=4 +tries=1 A "${domain}" @1.1.1.1 2>/dev/null || dig +short +time=4 +tries=1 A "${domain}" 2>/dev/null || true)"
  fi
  if [[ -z "${out}" ]] && command -v getent >/dev/null 2>&1; then
    out="$(getent ahostsv4 "${domain}" 2>/dev/null | awk '{print $1}' | sort -u || true)"
  fi
  if [[ -z "${out}" ]] && command -v curl >/dev/null 2>&1; then
    out="$(curl -fsS --max-time 4 -H 'accept: application/dns-json' "https://1.1.1.1/dns-query?name=${domain}&type=A" 2>/dev/null \
      | grep -oE '"data":"([0-9]{1,3}\.){3}[0-9]{1,3}"' \
      | cut -d'"' -f4 || true)"
  fi
  printf '%s\n' "${out}" | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | sort -u || true
}

_setup_bootstrap_deps() {
  local -a missing_pkgs=()
  command -v curl >/dev/null 2>&1 || missing_pkgs+=(curl)
  command -v openssl >/dev/null 2>&1 || missing_pkgs+=(openssl)
  [[ -d /etc/ssl/certs ]] || missing_pkgs+=(ca-certificates)
  if (( ${#missing_pkgs[@]} > 0 )); then
    log_info "正在安装交互向导所需的最小依赖: ${missing_pkgs[*]}"
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -qq
    apt-get install -y -qq --no-install-recommends "${missing_pkgs[@]}"
  fi
}

_setup_prompt_hy2_opts() {
  local input_fd="$1"
  local -n _hy2_port_ref="$2"
  local -n _hy2_obfs_ref="$3"
  local -n _hy2_hop_ref="$4"
  local -n _hy2_up_ref="$5"
  local -n _hy2_down_ref="$6"

  _setup_prompt_validated "${input_fd}" "Hysteria2 UDP 端口 (HY2_PORT)" "${_hy2_port_ref:-${DEFAULT_HY2_PORT}}" \
    is_valid_port "端口必须为 1-65535 整数。" _hy2_port_ref
  _setup_prompt_validated "${input_fd}" "启用 salamander 混淆 (HY2_OBFS: true/false)" "${_hy2_obfs_ref:-${DEFAULT_HY2_OBFS}}" \
    is_valid_bool "请输入 true 或 false。" _hy2_obfs_ref "true"
  _setup_prompt_validated "${input_fd}" "端口跳跃范围 (HY2_HOP_PORTS，如 20000-30000，留空跳过)" "${_hy2_hop_ref:-}" \
    _setup_valid_port_range_opt "端口跳跃范围格式无效（示例: 20000-30000，或留空关闭）。" _hy2_hop_ref
  _setup_prompt_validated "${input_fd}" "可选上行带宽 Mbps (HY2_UP_MBPS，留空使用 BBR)" "${_hy2_up_ref:-}" \
    _setup_valid_pos_int_opt "带宽必须为正整数或留空。" _hy2_up_ref
  _setup_prompt_validated "${input_fd}" "可选下行带宽 Mbps (HY2_DOWN_MBPS，留空使用 BBR)" "${_hy2_down_ref:-}" \
    _setup_valid_pos_int_opt "带宽必须为正整数或留空。" _hy2_down_ref
}

cmd_setup() {
  local config_only="false"
  while (( $# > 0 )); do
    case "$1" in
      --config-only)
        config_only="true"
        shift
        ;;
      *)
        die "未知选项: $1（用法: sudo ./singtun setup [--config-only]）"
        ;;
    esac
  done

  [[ "${SINGTUN_SETUP_CONFIG_ONLY:-false}" == "true" ]] && config_only="true"
  local skip_deploy="${config_only}"
  [[ "${SINGTUN_SETUP_SKIP_DEPLOY:-false}" == "true" ]] && skip_deploy="true"

  if [[ "${skip_deploy}" != "true" ]]; then
    require_root
    if [[ "${SKIP_OS_CHECK:-false}" != "true" && -r /etc/os-release ]]; then
      local os_id=""
      os_id="$(awk -F= '/^ID=/{gsub(/"/, "", $2); print tolower($2)}' /etc/os-release 2>/dev/null || true)"
      case "${os_id}" in
        ubuntu|debian) ;;
        *) die "当前系统 (${os_id:-unknown}) 暂不支持自动部署，请使用 Debian 或 Ubuntu 22.04+。" ;;
      esac
    fi
    _setup_bootstrap_deps
  fi

  local input_fd=0
  _SINGTUN_SETUP_OPENED_TTY="false"
  if [[ "${SINGTUN_SETUP_USE_STDIN:-false}" != "true" && ! -t 0 ]]; then
    if [[ -r /dev/tty ]]; then
      exec 3</dev/tty
      input_fd=3
      _SINGTUN_SETUP_OPENED_TTY="true"
    else
      die "当前非交互终端且无法打开 /dev/tty；请使用 './singtun init' 手动编辑 private/.env 后运行 'sudo ./singtun deploy'。"
    fi
  fi
  cleanup_setup_tty() {
    if [[ "${_SINGTUN_SETUP_OPENED_TTY:-false}" == "true" ]]; then
      exec 3<&- 2>/dev/null || true
      _SINGTUN_SETUP_OPENED_TTY="false"
    fi
    trap - RETURN
  }
  trap cleanup_setup_tty RETURN

  cmd_init
  load_env

  local def_domain="" def_ip="" existing_token="${CF_API_TOKEN:-}"
  if is_valid_domain "${SERVER_DOMAIN:-}" && ! is_reserved_example_domain "${SERVER_DOMAIN}"; then
    def_domain="${SERVER_DOMAIN}"
  fi
  if is_valid_ipv4 "${SERVER_IP:-}" && ! is_non_public_ipv4 "${SERVER_IP}" && ! _setup_is_doc_ipv4 "${SERVER_IP}"; then
    def_ip="${SERVER_IP}"
  else
    log_info "正在探测本机公网 IPv4..."
    def_ip="$(detect_public_ipv4 2>/dev/null || true)"
  fi

  printf '\n=== singtun 交互式部署向导 ===\n' >&2
  printf '提示：直接回车将使用方括号中的智能默认值。\n\n' >&2

  local in_domain="" in_ip=""
  while true; do
    _setup_prompt_validated "${input_fd}" "1/4 连接域名 (SERVER_DOMAIN，Cloudflare 须设为 DNS only)" "${def_domain}" \
      _setup_valid_domain_input "域名格式无效或不能使用 example.com 等示例域名，请输入真实子域名（如 node.yourdomain.com）。" in_domain "true"
    _setup_prompt_validated "${input_fd}" "2/4 服务器公网 IPv4 (SERVER_IP)" "${def_ip}" \
      _setup_valid_public_ip_input "请输入有效的公网 IPv4 地址。" in_ip

    if [[ "${SINGTUN_SETUP_SKIP_DNS_CHECK:-false}" == "true" ]]; then
      break
    fi

    local dns_done="false" edit_again="false"
    while true; do
      local resolved_ips=""
      resolved_ips="$(_setup_resolve_a_records "${in_domain}")"
      if [[ -n "${resolved_ips}" ]] && grep -Fxq "${in_ip}" <<< "${resolved_ips}"; then
        log_info "DNS A 记录核验通过: ${in_domain} -> ${in_ip}"
        dns_done="true"
        break
      fi
      log_warn "DNS 核验未匹配：${in_domain} 当前 A 记录为 [${resolved_ips:-无解析}]，预期公网 IP 为 ${in_ip}。"
      log_warn "请确认已在 Cloudflare 添加 A 记录，且 Proxy status 为 DNS only（灰色云朵）。"
      local dns_action=""
      _setup_read_line "${input_fd}" "请选择: [R]重新检测 / [C]继续使用当前配置 / [E]修改域名或IP / [Q]退出 (默认 R): " "false" dns_action \
        || die "交互输入已结束，已中止 setup。"
      dns_action="$(_setup_trim "${dns_action}" | tr '[:upper:]' '[:lower:]')"
      [[ -z "${dns_action}" ]] && dns_action="r"
      case "${dns_action}" in
        r) continue ;;
        c) log_warn "已按用户选择跳过 DNS 匹配继续（后续 cert/preflight 阶段仍会校验域名）。"; dns_done="true"; break ;;
        e) def_domain="${in_domain}"; def_ip="${in_ip}"; edit_again="true"; break ;;
        q) log_info "已退出 setup 向导，未修改配置。"; return 0 ;;
        *) log_warn "无效选项，请输入 R、C、E 或 Q。" ;;
      esac
    done
    [[ "${edit_again}" == "true" ]] && continue
    [[ "${dns_done}" == "true" ]] && break
  done

  local in_token="" tok_prompt=""
  if [[ -n "${existing_token}" ]]; then
    tok_prompt="3/4 Cloudflare API Token (仅需 Zone.DNS:Edit，直接回车保留已有 Token): "
  else
    tok_prompt="3/4 Cloudflare API Token (仅需 Zone.DNS:Edit，输入默认不回显): "
  fi
  while true; do
    _setup_read_line "${input_fd}" "${tok_prompt}" "true" in_token \
      || die "交互输入已结束，已中止 setup。"
    in_token="$(_setup_trim "${in_token}")"
    if [[ -z "${in_token}" && -n "${existing_token}" ]]; then
      in_token="${existing_token}"
    fi
    if [[ -z "${in_token}" ]]; then
      log_warn "CF_API_TOKEN 不能为空。"
      continue
    fi
    if [[ "${in_token}" =~ [[:space:]\'\"\`\$\\] ]]; then
      log_warn "CF_API_TOKEN 不可包含空白符、引号或特殊转义字符。"
      continue
    fi
    break
  done

  local def_email="" in_email=""
  if is_valid_email "${ACME_EMAIL:-}" && ! is_reserved_example_email "${ACME_EMAIL}"; then
    def_email="${ACME_EMAIL}"
  else
    def_email="$(derive_default_acme_email "${in_domain}")"
  fi
  _setup_prompt_validated "${input_fd}" "4/4 ACME 证书通知邮箱 (ACME_EMAIL)" "${def_email}" \
    _setup_valid_email_input "邮箱格式无效或为 example.com 等保留示例邮箱，请输入有效邮箱。" in_email "true"

  printf '\n请选择部署方案:\n' >&2
  printf '  [1] 推荐标准模式 — VLESS + REALITY + Vision，公网订阅开启，IPv4 only（默认）\n' >&2
  printf '  [2] 标准 + Hysteria2 备用模式 — 额外开启 UDP 8443 Hysteria2（可选端口跳跃与混淆）\n' >&2
  printf '  [3] 高级自定义模式 — 逐项调整版本、端口、日志级别、IPv6、DNS 与 Hysteria2\n' >&2

  local mode_choice=""
  while true; do
    _setup_read_line "${input_fd}" "请输入选项 [1-3] (默认 1): " "false" mode_choice \
      || die "交互输入已结束，已中止 setup。"
    mode_choice="$(_setup_trim "${mode_choice}")"
    [[ -z "${mode_choice}" ]] && mode_choice="1"
    case "${mode_choice}" in
      1|2|3) break ;;
      *) log_warn "请输入 1、2 或 3。" ;;
    esac
  done

  local in_sb_ver="${SINGBOX_VERSION}"
  local in_sb_compat="${SINGBOX_CLIENT_COMPAT}"
  local in_vless_port="${VLESS_PORT}"
  local in_hs_port="${REALITY_HANDSHAKE_PORT}"
  local in_ipv6="false"
  local in_log_level="${SERVER_LOG_LEVEL}"
  local in_enable_sub="true"
  local in_dns_direct="${DNS_DIRECT}"
  local in_dns_remote="${DNS_REMOTE}"
  local in_enable_hy2="false"
  local in_hy2_port="${HY2_PORT}"
  local in_hy2_obfs="${HY2_OBFS}"
  local in_hy2_hop="${HY2_HOP_PORTS:-}"
  local in_hy2_up="${HY2_UP_MBPS:-}"
  local in_hy2_down="${HY2_DOWN_MBPS:-}"

  if [[ "${mode_choice}" == "2" ]]; then
    in_enable_hy2="true"
    _setup_prompt_hy2_opts "${input_fd}" in_hy2_port in_hy2_obfs in_hy2_hop in_hy2_up in_hy2_down
  elif [[ "${mode_choice}" == "3" ]]; then
    _setup_prompt_validated "${input_fd}" "sing-box 版本 (SINGBOX_VERSION)" "${in_sb_ver}" \
      _setup_valid_sb_ver "版本号格式无效（示例: 1.14.4）。" in_sb_ver
    _setup_prompt_validated "${input_fd}" "客户端语法兼容版本 (SINGBOX_CLIENT_COMPAT: 1.14/1.12)" "${in_sb_compat}" \
      is_valid_singbox_compat "仅支持 1.14 或 1.12。" in_sb_compat
    _setup_prompt_validated "${input_fd}" "VLESS 入站端口 (VLESS_PORT)" "${in_vless_port}" \
      is_valid_port "端口必须为 1-65535 整数。" in_vless_port
    _setup_prompt_validated "${input_fd}" "本机回落 Nginx 端口 (REALITY_HANDSHAKE_PORT)" "${in_hs_port}" \
      is_valid_port "端口必须为 1-65535 整数。" in_hs_port
    _setup_prompt_validated "${input_fd}" "启用服务端 IPv6 (SERVER_IPV6: true/false)" "${SERVER_IPV6}" \
      is_valid_bool "请输入 true 或 false。" in_ipv6 "true"
    _setup_prompt_validated "${input_fd}" "服务端日志级别 (SERVER_LOG_LEVEL)" "${in_log_level}" \
      is_valid_log_level "日志级别必须为 trace|debug|info|warn|error|fatal|panic。" in_log_level "true"
    _setup_prompt_validated "${input_fd}" "开启公网高熵订阅托管 (ENABLE_SUBSCRIPTION: true/false)" "${ENABLE_SUBSCRIPTION}" \
      is_valid_bool "请输入 true 或 false。" in_enable_sub "true"
    _setup_prompt_validated "${input_fd}" "国内直连 IP-DoH (DNS_DIRECT: 223.5.5.5|223.6.6.6)" "${in_dns_direct}" \
      is_valid_dns_direct_ip "仅支持 223.5.5.5 或 223.6.6.6。" in_dns_direct
    _setup_prompt_validated "${input_fd}" "海外代理 IP-DoH (DNS_REMOTE: 1.1.1.1|1.0.0.1|8.8.8.8|8.8.4.4|9.9.9.9)" "${in_dns_remote}" \
      is_valid_dns_remote_ip "仅支持 1.1.1.1 / 1.0.0.1 / 8.8.8.8 / 8.8.4.4 / 9.9.9.9。" in_dns_remote
    _setup_prompt_validated "${input_fd}" "启用 Hysteria2 备用入站 (ENABLE_HY2: true/false)" "${ENABLE_HY2}" \
      is_valid_bool "请输入 true 或 false。" in_enable_hy2 "true"
    if [[ "${in_enable_hy2}" == "true" ]]; then
      _setup_prompt_hy2_opts "${input_fd}" in_hy2_port in_hy2_obfs in_hy2_hop in_hy2_up in_hy2_down
    fi
  fi

  local masked_token=""
  if (( ${#in_token} >= 8 )); then
    masked_token="****${in_token: -4}"
  else
    masked_token="****(${#in_token}字符)"
  fi

  printf '\n%s\n' '--- 配置摘要（敏感信息已脱敏） ---' >&2
  printf '  SERVER_DOMAIN          = %s\n' "${in_domain}" >&2
  printf '  SERVER_IP              = %s\n' "${in_ip}" >&2
  printf '  ACME_EMAIL             = %s\n' "${in_email}" >&2
  printf '  CF_API_TOKEN           = %s\n' "${masked_token}" >&2
  printf '  SINGBOX_VERSION        = %s (compat: %s)\n' "${in_sb_ver}" "${in_sb_compat}" >&2
  printf '  VLESS_PORT             = %s (handshake: 127.0.0.1:%s)\n' "${in_vless_port}" "${in_hs_port}" >&2
  printf '  SERVER_IPV6            = %s\n' "${in_ipv6}" >&2
  printf '  SERVER_LOG_LEVEL       = %s\n' "${in_log_level}" >&2
  printf '  ENABLE_SUBSCRIPTION    = %s\n' "${in_enable_sub}" >&2
  printf '  DNS_DIRECT / REMOTE    = %s / %s\n' "${in_dns_direct}" "${in_dns_remote}" >&2
  printf '  ENABLE_HY2             = %s\n' "${in_enable_hy2}" >&2
  if [[ "${in_enable_hy2}" == "true" ]]; then
    printf '  HY2 (port/obfs/hop)    = %s / %s / %s\n' "${in_hy2_port}" "${in_hy2_obfs}" "${in_hy2_hop:-关闭}" >&2
  fi
  printf '%s\n' '--------------------------------------' >&2

  if ! _setup_prompt_yn "${input_fd}" "确认写入 ${ENV_FILE} 并继续? [Y/n]: " "y"; then
    log_info "已取消，未修改配置。"
    return 0
  fi

  env_file_apply_batch "${ENV_FILE}" \
    "SET:SERVER_DOMAIN=${in_domain}" \
    "SET:SERVER_IP=${in_ip}" \
    "SET:ACME_EMAIL=${in_email}" \
    "SET:CF_API_TOKEN=${in_token}" \
    "SET:SINGBOX_VERSION=${in_sb_ver}" \
    "SET:SINGBOX_CLIENT_COMPAT=${in_sb_compat}" \
    "SET:VLESS_PORT=${in_vless_port}" \
    "SET:REALITY_HANDSHAKE_PORT=${in_hs_port}" \
    "SET:SERVER_IPV6=${in_ipv6}" \
    "SET:SERVER_LOG_LEVEL=${in_log_level}" \
    "SET:ENABLE_SUBSCRIPTION=${in_enable_sub}" \
    "SET:DNS_DIRECT=${in_dns_direct}" \
    "SET:DNS_REMOTE=${in_dns_remote}" \
    "SET:ENABLE_HY2=${in_enable_hy2}" \
    "SET:HY2_PORT=${in_hy2_port}" \
    "SET:HY2_OBFS=${in_hy2_obfs}" \
    "SET:HY2_HOP_PORTS=${in_hy2_hop}" \
    "SET:HY2_UP_MBPS=${in_hy2_up}" \
    "SET:HY2_DOWN_MBPS=${in_hy2_down}"
  load_env
  log_info "配置已保存至 ${ENV_FILE}"

  if [[ "${skip_deploy}" == "true" ]]; then
    log_info "已仅完成配置写入；下一步请执行: sudo singtun deploy"
    return 0
  fi

  cmd_deploy
  load_env

  local -a existing_subs=()
  mapfile -t existing_subs < <(list_subscriptions || true)

  local create_sub="false"
  if (( ${#existing_subs[@]} == 0 )); then
    if _setup_prompt_yn "${input_fd}" "部署成功！是否立即创建首条客户端订阅? [Y/n]: " "y"; then
      create_sub="true"
    fi
  else
    if _setup_prompt_yn "${input_fd}" "部署成功（已有订阅: ${existing_subs[*]}），是否新建一条订阅? [y/N]: " "n"; then
      create_sub="true"
    fi
  fi

  if [[ "${create_sub}" == "true" ]]; then
    local sub_name=""
    while true; do
      _setup_read_line "${input_fd}" "订阅名称（仅小写字母/数字/短横线，回车自动命名为 sub-1 等）: " "false" sub_name \
        || die "交互输入已结束。"
      sub_name="$(_setup_trim "${sub_name}")"
      if [[ -z "${sub_name}" ]]; then
        break
      fi
      if is_valid_sub_name "${sub_name}" && ! is_reserved_sub_name "${sub_name}"; then
        local exists="false" s_item
        for s_item in "${existing_subs[@]}"; do
          if [[ "${s_item}" == "${sub_name}" ]]; then
            exists="true"
            break
          fi
        done
        if [[ "${exists}" == "true" ]]; then
          log_warn "订阅 [${sub_name}] 已存在，请换一个名称。"
          continue
        fi
        break
      fi
      log_warn "订阅名称格式无效（仅允许 1-32 位小写字母、数字和中间连字符，且不能为保留字）。"
    done

    local qr_choice=""
    while true; do
      _setup_read_line "${input_fd}" "终端输出二维码格式 [N(不显示)/v2ray/singbox/mihomo/sr/vless/hy2] (默认 N): " "false" qr_choice \
        || die "交互输入已结束。"
      qr_choice="$(_setup_trim "${qr_choice}" | tr '[:upper:]' '[:lower:]')"
      case "${qr_choice}" in
        ""|n|no) qr_choice=""; break ;;
        v2ray|singbox|mihomo|sr|vless|hy2) break ;;
        *) log_warn "不支持的二维码格式: ${qr_choice}" ;;
      esac
    done

    local -a add_args=()
    [[ -n "${sub_name}" ]] && add_args+=("${sub_name}")
    [[ -n "${qr_choice}" ]] && add_args+=(--qr "${qr_choice}")
    cmd_add "${add_args[@]}"
  fi

  log_info "singtun 部署完成！日常常用命令: sudo singtun status | sudo singtun add | sudo singtun logs"
}

main() {
  local subcmd="${1:-help}"
  shift || true

  if [[ "${subcmd}" != "help" && "${subcmd}" != "--help" && "${subcmd}" != "-h" ]] && has_help_flag "$@"; then
    print_command_help "${subcmd}"
    return $?
  fi

  case "${subcmd}" in
    setup)
      cmd_setup "$@"
      ;;
    init)
      cmd_init "$@"
      ;;
    deploy)
      cmd_deploy "$@"
      ;;
    add)
      cmd_add "$@"
      ;;
    list)
      cmd_list "$@"
      ;;
    show)
      cmd_show "$@"
      ;;
    reset)
      cmd_reset "$@"
      ;;
    del)
      cmd_del "$@"
      ;;
    flush)
      bash "${REPO_ROOT}/scripts/50-gen-clients.sh" "$@"
      ;;
    check)
      cmd_check "$@"
      ;;
    status)
      cmd_status "$@"
      ;;
    logs)
      cmd_logs "$@"
      ;;
    restart)
      cmd_restart "$@"
      ;;
    renew)
      cmd_renew "$@"
      ;;
    upgrade)
      cmd_upgrade "$@"
      ;;
    uninstall)
      cmd_uninstall "$@"
      ;;
    help|--help|-h)
      cmd_help "$@"
      ;;
    *)
      log_error "未知子命令: ${subcmd}"
      usage
      exit 1
      ;;
  esac
}

main "$@"
